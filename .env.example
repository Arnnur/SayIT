# Скопируйте этот файл в .env и заполните значения.
# .env не попадает в git — ключи остаются только у вас.

# === Обязательно ===
# Ключ Claude API: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# === Публикация в интернет (рекомендуется для демо с QR) ===
# Personal access token Netlify: https://app.netlify.com/user/applications#personal-access-tokens
# Если пусто — сайты раздаёт этот же сервер по адресу PUBLIC_BASE_URL/s/<id>/
NETLIFY_TOKEN=

# Публичный адрес этого сервера (без / в конце), например:
#   https://say-it.onrender.com   или   http://192.168.1.15:8000 (телефон в той же Wi-Fi сети)
# Если пусто — берётся адрес из запроса браузера (localhost не откроется на телефоне!)
PUBLIC_BASE_URL=

# === Картинки (необязательно) ===
# Ключ Pexels даёт более качественные фото: https://www.pexels.com/api/
# Без ключа используются фото LoremFlickr по ключевым словам.
PEXELS_API_KEY=

# === Тонкая настройка ИИ (можно не трогать) ===
CLAUDE_MODEL=claude-opus-5-5
# low = быстрее (30–60 с), medium/high = тщательнее, но дольше
CLAUDE_EFFORT=low
# true = fast mode: до 2.5× быстрее, но в 2 раза дороже
CLAUDE_FAST_MODE=false
CLAUDE_MAX_TOKENS=32000

# === Сервер ===
HOST=0.0.0.0
PORT=8000
# true = автоперезапуск при изменении кода (для разработки)
RELOAD=false
# Каким прокси доверять заголовки X-Forwarded-* ("*" на Render/Railway)
FORWARDED_ALLOW_IPS=127.0.0.1
DATA_DIR=data

# === Защита от злоупотреблений ===
RATE_LIMIT_REQUESTS=5
RATE_LIMIT_WINDOW_SECONDS=600
MAX_CONCURRENT_JOBS=3
